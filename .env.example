# ==============================================================================
# GEMINI LIVE ENGLISH TUTOR - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy file này thành .env và điền các API Key của bạn trước khi khởi chạy:
# cp .env.example .env
# ==============================================================================

# 1. DANH SÁCH 4 API KEY LUÂN PHIÊN (KEY ROTATION & AUTOMATIC FAILOVER)
# Khi kết nối WebSocket hoặc gọi REST gặp mã lỗi 429, RESOURCE_EXHAUSTED hoặc lỗi hạn ngạch,
# hệ thống sẽ tự động xoay vòng sang key tiếp theo trong danh sách mà không gián đoạn người dùng.
GEMINI_API_KEYS=YOUR_GEMINI_API_KEY_1,YOUR_GEMINI_API_KEY_2,YOUR_GEMINI_API_KEY_3,YOUR_GEMINI_API_KEY_4

# Hoặc sử dụng 1 API Key đơn lẻ nếu bạn chỉ có 1 key:
# GEMINI_API_KEY=AIzaSy...

# 2. DANH SÁCH MODEL LIVE THEO THỨ TỰ ƯU TIÊN (MODEL FALLBACK)
# Khi model chính bận hoặc gặp lỗi, hệ thống tự động fallback theo thứ tự sau:
FALLBACK_MODELS=gemini-3.8-live,gemini-3-flash-live,gemini-2.5-flash-native-audio,gemini-2.0-flash-exp

# Model Live khởi động mặc định:
MODEL=gemini-3.8-live

# 3. CẤU HÌNH SERVER FASTAPI
HOST=0.0.0.0
PORT=8000

# 4. TÍCH HỢP ĐÀM THOẠI QUA ĐIỆN THOẠI TWILIO (TÙY CHỌN)
# Bỏ ghi chú nếu bạn muốn kết nối Gia sư AI với tổng đài điện thoại Twilio:
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_APP_HOST=your_public_domain_or_ngrok.com